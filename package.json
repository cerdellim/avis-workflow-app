{
  "name": "volontari",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/phase8-checks.ts",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node scripts/phase7-checks.ts && node scripts/prove-restore.ts",
    "e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply volontari --local",
    "types": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "7.0.7",
    "@tanstack/react-query": "5.108.0",
    "hono": "4.13.19",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "5.20261118.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  }
}
